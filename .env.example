# Copie para .env.local e preencha. NUNCA versione o .env.local.
# Em produção, cadastre estes valores nas variáveis de ambiente da Vercel.

# --- Auth.js (login com Google) ---
# Gere com: npx auth secret   (ou: openssl rand -base64 33)
AUTH_SECRET=
# Google Cloud Console > APIs e serviços > Credenciais > ID do cliente OAuth (Aplicativo da Web)
# URI de redirecionamento autorizado: https://SEU-DOMINIO/api/auth/callback/google
#                                 e:  http://localhost:3000/api/auth/callback/google
AUTH_GOOGLE_ID=
AUTH_GOOGLE_SECRET=
# E-mails Google autorizados a entrar, separados por vírgula
ALLOWED_EMAILS=

# --- Pluggy (Open Finance) ---
# Painel da Pluggy > Aplicações. Use primeiro as credenciais de teste/sandbox.
PLUGGY_CLIENT_ID=
PLUGGY_CLIENT_SECRET=
# Fase 1: URL pública do webhook (inclui um segredo longo e aleatório no caminho)
# PLUGGY_WEBHOOK_URL=https://SEU-DOMINIO/api/webhooks/pluggy/SEGREDO

# --- Banco de dados (Neon Postgres) ---
# App: connection string POOLED (host com "-pooler")
DATABASE_URL=
# Migrações: connection string DIRETA (sem "-pooler")
DATABASE_URL_UNPOOLED=
